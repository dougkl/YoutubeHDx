<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dependency-free test runner (no NuGet packages needed). Run: dotnet run (from this folder). Exit code = number of failures. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\YoutubeHDx.Core\YoutubeHDx.Core.csproj" />
    <!-- Copies the host next to the tests so its protocol can be tested as a real process. -->
    <ProjectReference Include="..\..\src\YoutubeHDx.NativeHost\YoutubeHDx.NativeHost.csproj" />
  </ItemGroup>

</Project>
