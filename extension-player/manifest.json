{
  "manifest_version": 3,
  "name": "YoutubeHDx Player",
  "version": "1.7.0",
  "description": "Always 4K and clean English captions (never auto-generated) on YouTube, with your caption style.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YoutubeHDx Player settings",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "defaults.js",
        "content-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://lrclib.net/*",
    "https://api.opensubtitles.com/*",
    "https://*.opensubtitles.com/*",
    "https://*.opensubtitles.org/*"
  ]
}