{
  "manifest_version": 3,
  "name": "YoutubeHDx Player",
  "version": "1.10.3",
  "key": "",
  "description": "Always 4K and clean English captions (never auto-generated) on YouTube, with your caption style; TIDAL's audio for music videos (in sync, through your TIDAL tab) when it has the same recording.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "identity",
    "offscreen",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YoutubeHDx Player settings",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "defaults.js",
        "content-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tidal.com/*",
        "https://listen.tidal.com/*"
      ],
      "js": [
        "tidal.js",
        "tidal-remote.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://lrclib.net/*",
    "https://api.opensubtitles.com/*",
    "https://*.opensubtitles.com/*",
    "https://*.opensubtitles.org/*",
    "https://openapi.tidal.com/*",
    "https://auth.tidal.com/*",
    "https://*.tidal.com/*"
  ]
}
