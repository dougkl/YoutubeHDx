{
  "manifest_version": 3,
  "name": "YoutubeHDx Downloader",
  "version": "1.9.6",
  "description": "One-click 4K YouTube archiving to your NAS, using your YouTube account. Install on the download server.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "nativeMessaging",
    "cookies",
    "contextMenus",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YoutubeHDx Downloader",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}